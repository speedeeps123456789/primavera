{
automatic = 1;
code = "lookup ccmp_Other_1 {
	lookupflag 0;
	@Markscomb = [uni0307 gravecomb acutecomb uni030B uni0302 uni03020300 uni03020301 uni03020303 uni03020309 uni030C uni0306 uni03060300 uni03060301 uni03060303 uni03060309 tildecomb hookabovecomb uni030D uni030F uni0311 uni0358 dotaccent grave acute hungarumlaut circumflex caron breve ring tilde];
	@MarkscombCase = [uni0307.case gravecomb.case acutecomb.case uni030B.case uni0302.case uni03020300.case uni03020301.case uni03020303.case uni03020309.case uni030C.case uni0306.case uni03060300.case uni03060301.case uni03060303.case uni03060309.case tildecomb.case hookabovecomb.case uni030D.case uni030F.case uni0311.case uni0358.case dotaccent.case grave.case acute.case hungarumlaut.case circumflex.case caron.case breve.case ring.case tilde.case];
	sub @Markscomb @Markscomb' by @MarkscombCase;
	sub @Uppercase @Markscomb' by @MarkscombCase;
} ccmp_Other_1;

lookup ccmp_Other_2 {
	lookupflag 0;
	sub @Markscomb' @MarkscombCase by @MarkscombCase;
	sub @MarkscombCase @Markscomb' by @MarkscombCase;
} ccmp_Other_2;
";
tag = ccmp;
},
{
automatic = 1;
code = "script latn;

language AZE CRT KAZ TAT TRK;
lookup idotaccent {
	sub i by i.loclTRK;
} idotaccent;

language HUN;
lookup locl_latn_1 {
	sub Eacute by Eacute.loclHUN;
	sub Iacute by Iacute.loclHUN;
	sub Oacute by Oacute.loclHUN;
	sub Uacute by Uacute.loclHUN;
	sub Aacute by Aacute.loclHUN;
	sub eacute by eacute.loclHUN;
	sub iacute by iacute.loclHUN;
	sub oacute by oacute.loclHUN;
	sub ohungarumlaut by ohungarumlaut.loclHUN;
	sub uacute by uacute.loclHUN;
	sub uhungarumlaut by uhungarumlaut.loclHUN;
	sub aacute by aacute.loclHUN;
	sub acutecomb by acutecomb.loclHUN;
} locl_latn_1;

language NLD;
lookup locl_latn_2 {
	sub I by I.loclNLD;
	sub J by J.loclNLD;
	sub i by i.loclNLD;
	sub j by j.loclNLD;
} locl_latn_2;

language PLK;
lookup locl_latn_3 {
	sub Nacute by Nacute.loclPLK;
	sub Oacute by Oacute.loclPLK;
	sub Sacute by Sacute.loclPLK;
	sub Zacute by Zacute.loclPLK;
	sub Cacute by Cacute.loclPLK;
	sub acute by acute.loclPLK;
} locl_latn_3;

language CAT;
lookup puntvolatlig {
	sub  l' periodcentered' l by ldot;
	sub  L' periodcentered' L by Ldot;
} puntvolatlig;

script cyrl;

language BGR;
lookup locl_cyrl_0 {
	sub uni0424 by uni0424.loclBGR;
	sub uni0432 by uni0432.loclBGR;
	sub uni0433 by uni0433.loclBGR;
	sub uni0436 by uni0436.loclBGR;
	sub uni0437 by uni0437.loclBGR;
	sub uni043A by uni043A.loclBGR;
	sub uni043D by uni043D.loclBGR;
	sub uni043F by uni043F.loclBGR;
	sub uni0440 by uni0440.loclBGR;
	sub uni0442 by uni0442.loclBGR;
	sub uni0444 by uni0444.loclBGR;
	sub uni0447 by uni0447.loclBGR;
	sub uni0446 by uni0446.loclBGR;
	sub uni0448 by uni0448.loclBGR;
	sub uni0449 by uni0449.loclBGR;
	sub uni044C by uni044C.loclBGR;
	sub uni044B by uni044B.loclBGR;
	sub uni044A by uni044A.loclBGR;
	sub uni044E by uni044E.loclBGR;
} locl_cyrl_0;

language BSH;
lookup locl_cyrl_1 {
	sub uni0492 by uni0492.loclBSH;
	sub uni0498 by uni0498.loclBSH;
	sub uni04AA by uni04AA.loclBSH;
	sub uni0493 by uni0493.loclBSH;
	sub uni0499 by uni0499.loclBSH;
	sub uni04AB by uni04AB.loclBSH;
} locl_cyrl_1;

language CHU;
lookup locl_cyrl_2 {
	sub uni04AA by uni04AA.loclCHU;
	sub uni04AB by uni04AB.loclCHU;
} locl_cyrl_2;
";
